      "answer_assertions": {"contains_any": ["review", "conflict", "staged"]},
      "recorded_turns": [{"tool_calls": [{"name": "search_parts", "arguments": {"filters": {"part_number": "2N7002"}}}]}, {"tool_calls": [{"name": "lookup_part_specs", "arguments": {"part_id": 1}}]}, {"text": "The supplier data conflicts with existing data, so I staged it for review."}]
    },
    {
      "id": "pending_review_resolution",
      "starting_database": {"parts": [{"part_category": "mosfet", "profile": "discrete_ic", "quantity": 1, "part_number": "2N7002"}], "pending_reviews": [{"part_id": 1, "fields": {"manufacturer": "Recorded Semiconductor"}}]},
      "conversation": [{"user": "Apply the pending review for 2N7002."}],
      "allowed_approvals": {"apply_review": true},
      "tool_constraints": {"required_sequence": ["list_pending_reviews", "apply_review", "apply_review", "get_provenance"], "allowed_mutations": ["apply_review"], "max_calls": 4},
      "expected_final_state": {"parts_count": 1, "part_assertions": {"1": {"manufacturer": "Recorded Semiconductor"}}, "reviews": {}, "provenance_fields": {"1": ["manufacturer"]}},
      "answer_assertions": {"contains_any": ["applied", "review", "provenance"]},
      "recorded_turns": [{"tool_calls": [{"name": "list_pending_reviews", "arguments": {}}]}, {"tool_calls": [{"name": "apply_review", "arguments": {"part_id": 1}}]}, {"tool_calls": [{"name": "apply_review", "arguments": {"part_id": 1}}]}, {"tool_calls": [{"name": "get_provenance", "arguments": {"part_id": 1}}]}, {"text": "Applied the review and recorded its provenance."}]
    },
    {
      "id": "photo_identification_uncertainty",
      "starting_database": {"parts": []},
      "conversation": [{"user": "Identify and add this part from the photo.", "image": true}],
      "allowed_approvals": {},
      "tool_constraints": {"required_sequence": [], "forbidden": ["add_part", "add_stock", "update_part"], "max_calls": 0},
      "expected_final_state": {"parts_count": 0, "reviews": {}},
      "answer_assertions": {"contains_any": ["cannot", "uncertain", "clearer", "identify"]},
      "recorded_turns": [{"text": "I cannot identify the part confidently from this photo; please provide a clearer marking."}]
    },
    {
      "id": "large_inventory_search",
      "starting_database": {"large_inventory": {"count": 101, "part_category": "resistor", "value": "10k"}},
      "conversation": [{"user": "How many 10k resistors are in stock?"}],
