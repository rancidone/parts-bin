      "id": "ambiguous_reference",
      "starting_database": {"parts": [{"part_category": "resistor", "profile": "passive", "quantity": 5, "value": "10k", "package": "0402"}, {"part_category": "resistor", "profile": "passive", "quantity": 7, "value": "10k", "package": "0603"}]},
      "conversation": [{"user": "Add three to the 10k resistor."}],
      "allowed_approvals": {},
      "tool_constraints": {"required_sequence": [], "forbidden": ["add_stock", "update_part", "bulk_update_parts", "delete_part"], "max_calls": 0},
      "expected_final_state": {"parts_count": 2, "part_assertions": {"1": {"quantity": 5}, "2": {"quantity": 7}}, "reviews": {}},
      "answer_assertions": {"contains_any": ["which", "0402", "0603", "clarify"]},
      "recorded_turns": [{"text": "Which 10k resistor do you mean: the 0402 or 0603?"}]
    },
    {
      "id": "duplicate_part",
      "starting_database": {"parts": [{"part_category": "resistor", "profile": "passive", "quantity": 4, "value": "10k", "package": "0603"}]},
      "conversation": [{"user": "Add four 10K 0603 resistors."}],
      "allowed_approvals": {},
      "tool_constraints": {"required_sequence": ["search_parts"], "forbidden": ["add_part"], "max_calls": 1},
      "expected_final_state": {"parts_count": 1, "part_assertions": {"1": {"quantity": 4}}, "reviews": {}},
      "answer_assertions": {"contains_any": ["already", "duplicate", "existing"]},
      "recorded_turns": [{"tool_calls": [{"name": "search_parts", "arguments": {"filters": {"part_category": "resistor", "value": "10k", "package": "0603"}}}]}, {"text": "That part already exists; should I add stock to it?"}]
    },
    {
