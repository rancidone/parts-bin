      "expected_final_state": {"parts_count": 2, "part_assertions": {"1": {"quantity": 2}, "2": {"quantity": 3}}, "reviews": {}},
      "answer_assertions": {"contains_any": ["which", "0402", "0603", "clarify"]},
      "recorded_turns": [{"tool_calls": [{"name": "search_parts", "arguments": {"filters": {"part_category": "capacitor", "value": "100n"}}}]}, {"text": "I found two packages; which one should be deleted?"}]
