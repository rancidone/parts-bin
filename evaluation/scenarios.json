    },
    {
      "id": "enrichment_conflict",
      "starting_database": {"parts": [{"part_category": "mosfet", "profile": "discrete_ic", "quantity": 1, "part_number": "2N7002", "manufacturer": "Existing Maker"}]},
      "conversation": [{"user": "Look up specs for 2N7002."}],
