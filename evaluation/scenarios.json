      "answer_assertions": {"contains_any": ["updated", "renamed"]},
      "recorded_turns": [{"tool_calls": [{"name": "search_parts", "arguments": {"filters": {"part_category": "resistor", "value": "10k", "package": "0603"}}}]}, {"tool_calls": [{"name": "update_part", "arguments": {"part_id": 1, "fields": {"description": "precision resistor"}}}]}, {"tool_calls": [{"name": "update_part", "arguments": {"part_id": 1, "fields": {"description": "precision resistor"}}}]}, {"text": "Updated the identified resistor."}]
    },
    {
      "id": "refuse_ambiguous_delete",
      "starting_database": {"parts": [{"part_category": "capacitor", "profile": "passive", "quantity": 2, "value": "100n", "package": "0402"}, {"part_category": "capacitor", "profile": "passive", "quantity": 3, "value": "100n", "package": "0603"}]},
      "conversation": [{"user": "Delete the 100n capacitor."}],
