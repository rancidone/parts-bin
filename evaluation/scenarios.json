      "starting_database": {"parts": []},
      "conversation": [{"user": "Add some resistors."}],
      "allowed_approvals": {},
      "tool_constraints": {"required_sequence": [], "forbidden": ["add_part", "add_stock"], "max_calls": 0},
      "expected_final_state": {"parts_count": 0, "reviews": {}},
      "answer_assertions": {"contains_any": ["value", "quantity", "package", "need"]},
      "recorded_turns": [{"text": "I need the resistor value and quantity before I can add it."}]
    },
    {
