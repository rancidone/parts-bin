      "recorded_turns": [{"tool_calls": [{"name": "search_parts", "arguments": {"filters": {"part_category": "resistor", "value": "10k"}, "limit": 10}}]}, {"text": "There are 101 matching resistors in inventory."}]
    },
    {
      "id": "tool_error_recovery",
      "starting_database": {"parts": [{"part_category": "resistor", "profile": "passive", "quantity": 1, "value": "10k", "package": "0603"}]},
      "conversation": [{"user": "Find my 10k resistor."}],
      "allowed_approvals": {},
      "tool_constraints": {"required_sequence": ["not_a_tool", "search_parts"], "allowed_errors": ["invalid_input"], "max_calls": 2},
      "expected_final_state": {"parts_count": 1, "part_assertions": {"1": {"quantity": 1}}, "reviews": {}},
